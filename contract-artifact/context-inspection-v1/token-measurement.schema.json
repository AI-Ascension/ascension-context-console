{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-inspection:token-measurement:v1",
  "title": "Proposed token measurement v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "metric": {
      "enum": [
        "input_tokens",
        "output_tokens",
        "cached_input_tokens",
        "cache_write_input_tokens",
        "reasoning_output_tokens"
      ]
    },
    "value": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "source": {
      "enum": [
        "unavailable",
        "heuristic",
        "local_tokenizer",
        "provider_reported"
      ]
    },
    "scope": {
      "enum": [
        "component",
        "prepared_input",
        "provider_turn",
        "episode_cumulative"
      ]
    },
    "measurement_revision": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_turn_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "metric",
    "value",
    "source",
    "scope",
    "measurement_revision",
    "provider_turn_ref"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "source": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "value": {
            "type": "null"
          },
          "measurement_revision": {
            "type": "null"
          },
          "provider_turn_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "value": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "enum": [
              "heuristic",
              "local_tokenizer"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "measurement_revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "source": {
            "const": "provider_reported"
          }
        }
      },
      "then": {
        "properties": {
          "provider_turn_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          }
        }
      }
    }
  ]
}
