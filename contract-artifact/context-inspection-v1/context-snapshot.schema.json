{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.context-snapshot.v1"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "model_execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "provider_attempt_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "run_id",
        "episode_id",
        "agent_id",
        "model_execution_id",
        "provider_attempt_id"
      ]
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "repository": {
          "type": "string",
          "maxLength": 256
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "adapter_revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "evidence": {
          "enum": [
            "synthetic",
            "source-derived",
            "native-application-boundary"
          ]
        }
      },
      "required": [
        "repository",
        "revision",
        "adapter_revision",
        "evidence"
      ]
    },
    "boundary": {
      "enum": [
        "harness.request",
        "adapter.cli_input",
        "adapter.http_body"
      ]
    },
    "capture_mode": {
      "enum": [
        "metadata",
        "memory",
        "private"
      ]
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "additional_context": {
          "const": "not_exposed"
        }
      },
      "required": [
        "name",
        "model",
        "additional_context"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "application_capture_complete": {
      "type": "boolean"
    },
    "incomplete_reasons": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "content_excluded",
          "component_missing",
          "unsupported_attachment",
          "capture_limit",
          "redacted",
          "partial_write_capture",
          "producer_unknown",
          "metadata_only"
        ]
      }
    },
    "parent_snapshot_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "mapping": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "upstream_field": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
          },
          "transformation": {
            "enum": [
              "forwarded",
              "rendered_as_text",
              "mapped_to_schema",
              "mapped_to_configuration",
              "omitted",
              "unsupported"
            ]
          },
          "component_ids": {
            "type": "array",
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            }
          }
        },
        "required": [
          "upstream_field",
          "transformation",
          "component_ids"
        ]
      }
    },
    "input_measurement": {
      "$ref": "#/$defs/tokenMeasurement"
    },
    "model_context_limit_tokens": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "model_limit_source": {
      "enum": [
        "unavailable",
        "verified_configuration"
      ]
    }
  },
  "required": [
    "schema",
    "snapshot_id",
    "identity",
    "producer",
    "boundary",
    "capture_mode",
    "provider",
    "recorded_at",
    "application_capture_complete",
    "incomplete_reasons",
    "parent_snapshot_id",
    "components",
    "mapping",
    "input_measurement",
    "model_context_limit_tokens",
    "model_limit_source"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-inspection:snapshot:v1",
  "title": "Proposed immutable application-boundary snapshot v1",
  "$defs": {
    "component": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "component_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "ordinal": {
          "type": "integer",
          "minimum": 0,
          "maximum": 127
        },
        "kind": {
          "enum": [
            "harness_request",
            "stdin",
            "serialized_http_body",
            "system_message",
            "user_message",
            "output_schema",
            "configuration",
            "attachment",
            "opaque"
          ]
        },
        "role": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "system",
            "developer",
            "user",
            "assistant",
            "tool"
          ]
        },
        "media_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "observed_bytes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16777216
        },
        "content_status": {
          "enum": [
            "complete",
            "metadata_only",
            "redacted",
            "partial",
            "unavailable"
          ]
        },
        "content_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "origin": {
          "enum": [
            "harness",
            "adapter",
            "artifact",
            "operator_fixture"
          ]
        },
        "measurement": {
          "$ref": "#/$defs/tokenMeasurement"
        }
      },
      "required": [
        "component_id",
        "ordinal",
        "kind",
        "role",
        "media_type",
        "observed_bytes",
        "content_status",
        "content_ref",
        "sha256",
        "origin",
        "measurement"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "content_status": {
                "const": "complete"
              }
            }
          },
          "then": {
            "properties": {
              "content_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "content_status": {
                "enum": [
                  "metadata_only",
                  "unavailable"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "content_ref": {
                "type": "null"
              },
              "sha256": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "content_status": {
                "enum": [
                  "redacted",
                  "partial"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "content_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            }
          }
        }
      ]
    },
    "tokenMeasurement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "metric": {
          "enum": [
            "input_tokens",
            "output_tokens",
            "cached_input_tokens",
            "cache_write_input_tokens",
            "reasoning_output_tokens"
          ]
        },
        "value": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "enum": [
            "unavailable",
            "heuristic",
            "local_tokenizer",
            "provider_reported"
          ]
        },
        "scope": {
          "enum": [
            "component",
            "prepared_input",
            "provider_turn",
            "episode_cumulative"
          ]
        },
        "measurement_revision": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "provider_turn_ref": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "metric",
        "value",
        "source",
        "scope",
        "measurement_revision",
        "provider_turn_ref"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "unavailable"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "null"
              },
              "measurement_revision": {
                "type": "null"
              },
              "provider_turn_ref": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "heuristic",
                  "local_tokenizer"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "measurement_revision": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "const": "provider_reported"
              }
            }
          },
          "then": {
            "properties": {
              "provider_turn_ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
              }
            }
          }
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "application_capture_complete": {
            "const": true
          }
        }
      },
      "then": {
        "properties": {
          "incomplete_reasons": {
            "maxItems": 0
          },
          "components": {
            "items": {
              "properties": {
                "content_status": {
                  "const": "complete"
                }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "incomplete_reasons": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "capture_mode": {
            "const": "metadata"
          }
        }
      },
      "then": {
        "properties": {
          "application_capture_complete": {
            "const": false
          },
          "components": {
            "items": {
              "properties": {
                "content_status": {
                  "const": "metadata_only"
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "model_limit_source": {
            "const": "unavailable"
          }
        }
      },
      "then": {
        "properties": {
          "model_context_limit_tokens": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "model_context_limit_tokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "application_capture_complete": {
            "const": true
          },
          "boundary": {
            "const": "adapter.cli_input"
          }
        }
      },
      "then": {
        "properties": {
          "components": {
            "allOf": [
              {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "stdin"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "output_schema"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              },
              {
                "contains": {
                  "properties": {
                    "kind": {
                      "const": "configuration"
                    }
                  },
                  "required": [
                    "kind"
                  ]
                }
              }
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "application_capture_complete": {
            "const": true
          },
          "boundary": {
            "const": "adapter.http_body"
          }
        }
      },
      "then": {
        "properties": {
          "components": {
            "contains": {
              "properties": {
                "kind": {
                  "const": "serialized_http_body"
                }
              },
              "required": [
                "kind"
              ]
            }
          }
        }
      }
    }
  ]
}
