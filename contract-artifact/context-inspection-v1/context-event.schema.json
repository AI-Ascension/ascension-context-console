{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.context-event.v1"
    },
    "event_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "producer_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "snapshot_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_attempt_id": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "event_type": {
      "enum": [
        "snapshot.prepared",
        "input.write_completed",
        "input.write_failed",
        "provider.receipt_reported",
        "usage.reported",
        "decision.reference",
        "action.reference",
        "content.expired",
        "capture.gap",
        "attempt.interrupted"
      ]
    },
    "details": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "component_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "provider_request_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "model_execution_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "action_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "plan_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "metric": {
              "enum": [
                "input_tokens",
                "output_tokens",
                "cached_input_tokens",
                "cache_write_input_tokens",
                "reasoning_output_tokens"
              ]
            },
            "value": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                {
                  "type": "null"
                }
              ]
            },
            "source": {
              "enum": [
                "unavailable",
                "heuristic",
                "local_tokenizer",
                "provider_reported"
              ]
            },
            "scope": {
              "enum": [
                "component",
                "prepared_input",
                "provider_turn",
                "episode_cumulative"
              ]
            },
            "measurement_revision": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                {
                  "type": "null"
                }
              ]
            },
            "provider_turn_ref": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "metric",
            "value",
            "source",
            "scope",
            "measurement_revision",
            "provider_turn_ref"
          ],
          "allOf": [
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "unavailable"
                  }
                }
              },
              "then": {
                "properties": {
                  "value": {
                    "type": "null"
                  },
                  "measurement_revision": {
                    "type": "null"
                  },
                  "provider_turn_ref": {
                    "type": "null"
                  }
                }
              },
              "else": {
                "properties": {
                  "value": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source": {
                    "enum": [
                      "heuristic",
                      "local_tokenizer"
                    ]
                  }
                }
              },
              "then": {
                "properties": {
                  "measurement_revision": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  }
                }
              }
            },
            {
              "if": {
                "properties": {
                  "source": {
                    "const": "provider_reported"
                  }
                }
              },
              "then": {
                "properties": {
                  "provider_turn_ref": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 128,
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
                  }
                }
              }
            }
          ]
        },
        "dropped_entries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": []
    }
  },
  "required": [
    "schema",
    "event_id",
    "producer_id",
    "sequence",
    "snapshot_id",
    "provider_attempt_id",
    "observed_at",
    "event_type",
    "details"
  ],
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:context-inspection:event:v1",
  "title": "Proposed append-only capture lifecycle event v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "provider.receipt_reported"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "provider_request_ref"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "usage.reported"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "usage"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "action.reference"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "action_id",
              "model_execution_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "content.expired"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "component_id"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "capture.gap"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "code",
              "dropped_entries"
            ]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "event_type": {
            "const": "input.write_failed"
          }
        }
      },
      "then": {
        "properties": {
          "details": {
            "required": [
              "code"
            ]
          }
        }
      }
    }
  ]
}
