{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:provider-session:reconciliation:v1",
  "title": "Proposed Phase 4 reconciliation product contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.provider-session.reconciliation.v1"
    },
    "reconciliation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "operation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "binding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "outcome": {
      "enum": [
        "proven_not_sent",
        "observed_completion",
        "ambiguous",
        "quarantined"
      ]
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "maxItems": 16,
      "uniqueItems": true
    },
    "native_turn_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "auto_retry_generation": {
      "const": false
    },
    "scheduler_after": {
      "const": "held"
    },
    "new_generation_calls": {
      "const": 0
    }
  },
  "required": [
    "schema",
    "reconciliation_id",
    "operation_id",
    "binding_id",
    "scope",
    "outcome",
    "evidence_refs",
    "native_turn_ref",
    "auto_retry_generation",
    "scheduler_after",
    "new_generation_calls"
  ]
}
