{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:provider-session:prepared:v1",
  "title": "Proposed Phase 4 prepared product contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.provider-session.prepared.v1"
    },
    "prepared_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "binding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "phase2_preview_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "phase2_revision_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "phase3_selection_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "held_boundary_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "owner_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "control_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "session_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "history_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "compaction_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "auth_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "revocation_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "profile_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "continuity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "suffix_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "suffix_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "output_schema_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "output_schema_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "protected_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "protected_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "continuity_mode": {
      "enum": [
        "strict_reviewed",
        "observed_persistent"
      ]
    },
    "provider_internal_context": {
      "const": "unexposed"
    },
    "history_coverage": {
      "enum": [
        "application_manifest_verified",
        "reported_partial",
        "unknown"
      ]
    },
    "effect_class": {
      "const": "local_preparation_only"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "schema",
    "prepared_id",
    "scope",
    "binding_id",
    "phase2_preview_id",
    "phase2_revision_id",
    "phase3_selection_id",
    "held_boundary_ref",
    "owner_epoch",
    "control_generation",
    "session_epoch",
    "history_epoch",
    "compaction_epoch",
    "auth_epoch",
    "revocation_epoch",
    "profile_sha256",
    "continuity_sha256",
    "suffix_ref",
    "suffix_sha256",
    "output_schema_ref",
    "output_schema_sha256",
    "protected_ref",
    "protected_sha256",
    "dependency_ids",
    "continuity_mode",
    "provider_internal_context",
    "history_coverage",
    "effect_class",
    "expires_at"
  ]
}
