{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ascension:provider-session:compaction:v1",
  "title": "Proposed Phase 4 compaction product contract",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "ascension.provider-session.compaction.v1"
    },
    "job_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "run_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "episode_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        "agent_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        }
      },
      "required": [
        "project_id",
        "run_id",
        "episode_id",
        "agent_id"
      ]
    },
    "binding_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "source_history_epoch": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "source_continuity_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "dependency_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 128,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
      },
      "minItems": 0,
      "maxItems": 128,
      "uniqueItems": true
    },
    "state": {
      "enum": [
        "planned",
        "sent",
        "acknowledged",
        "transforming",
        "completed",
        "failed",
        "unknown",
        "cancelled"
      ]
    },
    "generation_permission": {
      "type": "boolean"
    },
    "budget_reservation_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "ack_received": {
      "type": "boolean"
    },
    "terminal_evidence_ref": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "history_epoch_after": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "representation": {
      "enum": [
        "pending",
        "opaque_native"
      ]
    },
    "automatic_adoption": {
      "const": false
    },
    "game_effects": {
      "const": 0
    },
    "scheduler_after": {
      "const": "held"
    }
  },
  "required": [
    "schema",
    "job_id",
    "scope",
    "binding_id",
    "source_history_epoch",
    "source_continuity_sha256",
    "dependency_ids",
    "state",
    "generation_permission",
    "budget_reservation_ref",
    "ack_received",
    "terminal_evidence_ref",
    "history_epoch_after",
    "representation",
    "automatic_adoption",
    "game_effects",
    "scheduler_after"
  ]
}
